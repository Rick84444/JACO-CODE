#!/data/data/com.termux/files/usr/bin/sh
set -eu
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
TMPDIR="${TMPDIR:-$PREFIX/tmp}"
PATH="$PREFIX/bin:$PREFIX/bin/applets:${PATH:-/system/bin}"
export PREFIX HOME TMPDIR PATH
ENV_FILE="${JACO_RUNTIME_ENV:-$HOME/.config/jaco/runtime.env}"
[ -f "$ENV_FILE" ] && . "$ENV_FILE"
# Never auto-fallback to an older checkout when runtime.env is missing or stale.
[ -f "$ENV_FILE" ] && [ -n "${JACO_ROOT:-}" ] && [ -f "$JACO_ROOT/../agents/nova-bridge.mjs" ] || {
  echo "JACO_ROOT_INVALID: configure the installed checkout in $ENV_FILE" >&2
  exit 41
}
REPO_ROOT="$(cd "$JACO_ROOT/.." && pwd)"
cd "$REPO_ROOT"
[ "${JACO_ENABLE_CDP:-0}" = "1" ] || { echo "JACO_ENABLE_CDP_DISABLED" >&2; exit 0; }
export NOVA_BRIDGE_PORT="${NOVA_BRIDGE_PORT:-4243}"
export CDP_PORT="${CDP_PORT:-9222}"
exec "$PREFIX/bin/node" agents/nova-bridge.mjs 2>&1
