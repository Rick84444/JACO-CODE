{
  "name": "jaco-cognitive-ide",
  "displayName": "JACO Code IDE",
  "description": "Your own AI agent inside VS Code: Aura plans, writes code in a safe copy of your project, uses a real browser and shows every step. Runs locally with your own model.",
  "version": "0.1.6",
  "publisher": "jacocode",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b1220",
    "theme": "dark"
  },
  "private": true,
  "license": "MIT",
  "homepage": "https://jacocode.com/",
  "bugs": {
    "url": "https://github.com/Rick84444/JACO-CODE/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "coding agent",
    "mcp",
    "browser automation",
    "local",
    "gemini",
    "ollama",
    "jaco"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onUri",
    "onView:jaco.workspace",
    "onCommand:jaco.openFullGUI",
    "onCommand:jaco.startRuntime",
    "onCommand:jaco.openBrowser",
    "onCommand:jaco.openTerminal"
  ],
  "contributes": {
    "commands": [
      {
        "command": "jaco.openFullGUI",
        "title": "JACO: Open Full IDE",
        "category": "JACO"
      },
      {
        "command": "jaco.startRuntime",
        "title": "JACO: Start Runtime",
        "category": "JACO"
      },
      {
        "command": "jaco.openBrowser",
        "title": "JACO: Open in External Browser",
        "category": "JACO"
      },
      {
        "command": "jaco.openTerminal",
        "title": "JACO: Open Terminal IDE",
        "category": "JACO"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jaco",
          "title": "JACO",
          "icon": "media/jaco.svg"
        }
      ]
    },
    "views": {
      "jaco": [
        {
          "id": "jaco.workspace",
          "name": "Workspace"
        }
      ]
    },
    "configuration": {
      "title": "JACO",
      "properties": {
        "jaco.runtimeUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3000",
          "description": "Local running JACO Core URL. This extension deliberately does not embed remote hosts."
        },
        "jaco.checkoutPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to the JACO-CODE checkout used by Start Runtime and Terminal IDE. Otherwise the active workspace must be the JACO-CODE checkout."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "check": "node --check extension.cjs && node --check lib/bridge.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rick84444/JACO-CODE.git"
  }
}
