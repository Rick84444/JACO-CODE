# JACO Environment Variables
# Copy to .env. Never commit real values here - this file must only ever
# contain variable names with empty or clearly-fake placeholder values.
#
# 2026-09-22: this file was found to contain dozens of real, live secrets that
# had accumulated over time and were already committed to git history. The
# original content (for audit/rotation purposes only) is preserved at
# .jaco/leaked-secrets-removed-from-env-example.txt, which is gitignored.
# Every credential listed there must be rotated.

# --- Core security ---
GATEWAY_TOKEN=
JACO_GATEWAY_TOKEN=
JACO_OPERATOR_TOKEN=
JACO_STRICT_REAL_ONLY=true
JACO_MAX_RESPONSE_TOKENS=1000

# --- Local model providers ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma3:4b
OLLAMA_API_KEY=
# Manual Aura chat: provider/model -> positive input/output USD per million tokens.
# Required for paid models outside the existing Ollama cloud price catalog.
JACO_AURA_PROVIDER_PRICES_JSON={}
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=
NOVA_LLM_ENDPOINT=
NOVA_LLM_TOKEN=
NOVA_LLM_MODEL=local-model
# Free tier (no card required): console.groq.com -> API Keys.
GROQ_API_KEY=

# --- Optional external model providers ---
GEMINI_API_KEY=
JACO_GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
HUGGINGFACE_INFERENCE_BASE_URL=
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=

# --- Optional Android/local engine ---
JACO_NATIVE_ENGINE_TOKEN=
JACO_NATIVE_ENGINE_PORT=37621
JACO_LITERT_URL=http://127.0.0.1:9379/v1
JACO_LITERT_MODEL=gemma-4-E4B-it-gpu.litertlm

# --- Optional SEER remote strategist gateways ---
OPENCLAW_GATEWAY_TOKEN=
HERMES_API_SERVER_KEY=
JACO_SEER_STRATEGIST_API_KEY=
JACO_SEER_REMOTE_HOSTS=
JACO_STRATEGIST_AUTO_DISCOVERY=true

# --- Commerce ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SKYFIRE_API_KEY=
COINBASE_COMMERCE_KEY=

# --- Cloudflare ---
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DEPLOY_API_TOKEN=
CLOUDFLARE_GATEWAY_WORKER_URL=
JACO_CLOUDFLARE_ENABLE_DEPLOY=false

# --- GitHub integration ---
GITHUB_TOKEN=
GITHUB_REPO=Rick84444/jaco-code

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://s3.hf.co/Rick8444
AWS_DEFAULT_REGION=us-east-1

# --- WordPress REST. Never commit real values. ---
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Notifications / approvals ---
NTFY_TOPIC=
APPROVAL_BASE_URL=http://127.0.0.1:3000

# --- A2A / Tunnel ---
A2A_BEARER_TOKEN=
A2A_NODE_UUID=
OPENCLAW_SECRET_HASH=
JACO_TUNNEL_ALIAS=jaco
JACO_TUNNEL_MCP_URL=http://127.0.0.1:2999/mcp
JACO_SENTINEL_URL=http://127.0.0.1:2999
JACO_TUNNEL_ID=jaco-ollama-secure-tunnel
JACO_TUNNEL_RUNTIME_KEY_ENV=JACO_TUNNEL_RUNTIME_KEY
JACO_TUNNEL_RUNTIME_KEY=

# --- Optional Firebase adapter. Leave blank to keep it disabled. ---
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# --- Connected runtime / mission bus ---
JACO_MISSION_BUS_TICK_MS=1200
JACO_PUBLIC_READS=false

# --- Autonomy: SEER governor + Workplace supervision ---
# Enable DeepSeek for SEER governor goal-planning (keeps all other cloud keys stripped).
# Required for the governor to produce reliable structured mission plans.
JACO_CLOUD_PLANNER=0
# Set to 1 to let Workplace auto-start and supervise SEER, Nova and the local model server.
# When enabled, killing a process restarts it automatically; Workplace owns the PID lifecycle.
JACO_WORKPLACE_SUPERVISE_SEER=1
JACO_WORKPLACE_SUPERVISE_NOVA=1
JACO_WORKPLACE_SUPERVISE_MODEL=1
JACO_LEVEL5_AUTONOMY=1
JACO_ALLOW_SHELL_TASKS=1
JACO_REMOTE_ALLOW_MUTATIONS=1
JACO_NOVA_ALLOWED_TASKS=detect-surfaces,health-check,check-revenue,browser-survey-site,browser-click,browser-type,desktop-windows,desktop-observe,desktop-action,desktop-invoke,windows-wmi-read,screenshot,get-cursor,invoke-worker,shell,repo-list,repo-read,repo-write,repo-test,git-status,git-diff,git-commit,git-push,git-merge
# Governor cycle interval in ms (default 300000 = 5 min). Set to 0 to disable.
SEER_GOVERNOR_INTERVAL_MS=300000
JACO_RATE_LIMIT_PER_MIN=600
JACO_SECRETS_FILE=
JACO_CONNECTED_BOOT_GOAL=
JACO_CONNECTED_DISCOVERY_URLS=
