# Example environment for a JACO workspace. Copy to .env and fill in locally.
# Never commit real values; .env is git-ignored.

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_GATEWAY_WORKER_URL=
JACO_CLOUDFLARE_ENABLE_DEPLOY=false

# Model providers
GEMINI_API_KEY=
JACO_GEMINI_MODEL=
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
JACO_OLLAMA_URL=http://127.0.0.1:11434
JACO_OLLAMA_MODEL=
JACO_PRIMARY_PROVIDER=
JACO_STARTUP_REQUIRE_LLM=true
HF_TOKEN=

# Runtime
GATEWAY_TOKEN=
A2A_NODE_UUID=
A2A_BEARER_TOKEN=
JACO_A2A_ALLOW_LOOPBACK_PEERS=false
JACO_A2A_PEER_TIMEOUT_MS=8000
JACO_JOB_LEASE_MS=600000
JACO_JOB_REAPER_INTERVAL_MS=60000
JACO_PUBLIC_READS=false
JACO_RATE_LIMIT_PER_MIN=600
JACO_STRATEGIST_AUTO_DISCOVERY=true
