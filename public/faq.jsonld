{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://jacocode.com/#faq",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Vad är JACO (Just Autonomous Agent Orchestrator)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JACO är ett användarstyrt autonomt agent-operativsystem för hantering av flera språkmodeller (Gemini, Ollama, OpenAI), persistent minne, verifierad källkodsgenerering och mobil integration via Termux på Android."
      }
    },
    {
      "@type": "Question",
      "name": "Hur skiljer sig JACO från OpenClaw, LangGraph och vanliga chattappar?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JACO kombinerar en lokal runtime, Termux-hårdvaruöverbryggning, PODAR-självförbättringsslinga, godkännandegrindar via push-notiser och ett Agent-to-Agent (A2A) marknadsplatsprotokoll i ett komplett och transparent system."
      }
    },
    {
      "@type": "Question",
      "name": "Kan JACO köras lokalt på Android via Termux?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, JACO kan installeras i Termux med Node.js och köras lokalt tillsammans med Ollama för helt offlinebaserad agentexekvering."
      }
    },
    {
      "@type": "Question",
      "name": "Hur hanteras säkerhet och godkännanden i JACO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Skadliga eller kritiska handlingar (kommandoexekvering och filskrivningar) kräver explicit godkännande via mobila push-notiser eller ett lokalt gränssnitt."
      }
    }
  ]
}
