#!/data/data/com.termux/files/usr/bin/sh
set -eu

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
TMPDIR="${TMPDIR:-$PREFIX/tmp}"
PATH="$PREFIX/bin:$PREFIX/bin/applets:${PATH:-/system/bin}"
mkdir -p "$TMPDIR"
export PREFIX HOME TMPDIR PATH

ENV_FILE="${JACO_RUNTIME_ENV:-$HOME/.config/jaco/runtime.env}"
[ -f "$ENV_FILE" ] && . "$ENV_FILE"
# Runit must never silently execute the obsolete ~/jaco-code checkout.
# jacoctl writes the canonical JACO_ROOT into the mode-600 runtime.env.
[ -f "$ENV_FILE" ] && [ -n "${JACO_ROOT:-}" ] && [ -f "$JACO_ROOT/run_termux_node.sh" ] || {
  echo "JACO_ROOT_INVALID: configure the installed checkout in $ENV_FILE" >&2
  exit 41
}
cd "$JACO_ROOT"
export HOST="${HOST:-127.0.0.1}"
export PORT="${PORT:-3000}"
exec "$PREFIX/bin/bash" "$JACO_ROOT/run_termux_node.sh" 2>&1
