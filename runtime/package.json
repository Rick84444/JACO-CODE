{
  "name": "jaco-autonomus-ide",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'); const p='firebase-applet-config.json'; try { if(!fs.existsSync(p)||!fs.readFileSync(p,'utf8').trim()){fs.writeFileSync(p,'{}');} else { JSON.parse(fs.readFileSync(p,'utf8')); } } catch(e){ fs.writeFileSync(p,'{}'); }\"",
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.cjs",
    "termux:start": "bash run_termux_node.sh",
    "runtime:start": "tsx scripts/jaco-runtime-daemon.ts",
    "jaco:up": "node scripts/jaco-ctl.mjs up",
    "jaco:up:peer": "node scripts/jaco-ctl.mjs up --with-peer",
    "jaco:up:trade": "node scripts/jaco-ctl.mjs up --with-trade",
    "jaco:up:browser": "node scripts/jaco-ctl.mjs up --with-browser",
    "jaco:down": "node scripts/jaco-ctl.mjs down",
    "jaco:down:all": "node scripts/jaco-ctl.mjs down --all",
    "jaco:status": "node scripts/jaco-ctl.mjs status",
    "jaco:logs": "node scripts/jaco-ctl.mjs logs",
    "termux:remap": "node scripts/remap_termux_paths.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:truth": "node scripts/verify_truthful_runtime.mjs",
    "test:frozen-hands-off": "node scripts/verify_frozen_hands_off.mjs",
    "test:a2a-hardening": "node --import tsx scripts/verify_a2a_hardening.ts",
    "test:frozen": "npm run lint && npm run test:truth && npm run test:frozen-hands-off && npm run test:a2a-hardening && npm run test:rce-closed",
    "test:rce-closed": "node --import tsx scripts/verify_rce_closed.ts",
    "test:mcp": "node tools/jaco-mcp-test.mjs",
    "test:release": "npm run test:truth && npm run test:frozen-hands-off && npm run test:021 && npm run test:mcp && npm run test:secrets && npm run test:rce-closed",
    "preflight:port": "node scripts/preflight_port.mjs",
    "runtime:identity": "node scripts/verify_runtime_identity.mjs",
    "test:secrets": "node scripts/verify_secret_patterns.mjs",
    "test:connected": "node scripts/verify_connected_0191.mjs",
    "test:wifi-contract": "node scripts/verify_wifi_mcp_contract.mjs",
    "test:rollup-native": "node scripts/verify_rollup_native_resolver.mjs",
    "test:sqlite-cjs": "node scripts/verify_sqlite_cjs_0191.mjs",
    "test:cognitive-kernel": "node scripts/continuum/cognitive-kernel-v1.test.mjs",
    "test:continuum-runtime": "node scripts/continuum/runtime-behavior.test.mjs && node scripts/continuum/promotion-route-parity.test.mjs && node scripts/continuum/knowledge-lifecycle.test.mjs && node scripts/continuum/hypothesis-terminal-evidence.test.mjs && node scripts/continuum/cognitive-kernel-v1.test.mjs && node scripts/continuum/cognitive-continuity-runtime.test.mjs",
    "test:ledger": "node scripts/continuum/ledger-integrity.test.mjs",
    "test:idle-churn": "node scripts/continuum/idle-churn.test.mjs",
    "test:model-pool": "node --import tsx scripts/verify_model_pool_providers.mjs",
    "ledger:repair": "node scripts/continuum/repair-ledger.mjs",
    "test:a2a-continuum": "node gateway/test/a2a-continuum.test.mjs",
    "test:a2a-v1": "node gateway/test/a2a-v1-production.test.mjs",
    "test:a2a-outbound": "node scripts/continuum/a2a-outbound.test.mjs",
    "test:continuum-standalone": "node scripts/continuum/standalone-integration.test.mjs",
    "test:reflective-futures": "node scripts/continuum/reflective-futures.test.mjs",
    "test:021": "node scripts/verify_021_reflective_futures.mjs",
    "test:release:021": "npm run test:021 && npm run test:reflective-futures && npm run test:continuum-runtime && npm run test:ledger && npm run test:idle-churn && npm run test:continuum-standalone && npm run test:a2a-continuum && npm run test:a2a-v1 && npm run test:a2a-outbound && npm run test:truth && npm run test:frozen-hands-off && npm run test:connected && npm run test:wifi-contract && node scripts/verify_gateway_wip.mjs && node gateway/test/tool-registry.test.mjs && node gateway/test/security.test.mjs && node gateway/test/sdk-boundary.test.mjs && npm run test:secrets && npm run test:rollup-native && npm run test:sqlite-cjs",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --banner:js=\"#!/usr/bin/env node\" --outdir=dist --out-extension:.js=.cjs",
    "build:termux": "npm run build:client",
    "verify:aura-operator": "node scripts/verify_aura_operator_workbench.mjs",
    "verify:aura-operator:strict": "node scripts/verify_aura_operator_workbench.mjs --strict-product",
    "test:workspace-ux": "node --import tsx --test src/lib/workspaceUx.test.tsx"
  },
  "dependencies": {
    "@google/genai": "^2.13.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "lucide-react": "^0.546.0",
    "monaco-editor": "^0.52.2",
    "motion": "^12.23.24",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.0",
    "stripe": "^22.5.0",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "bin": {
    "jaco": "./dist/server.cjs"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
