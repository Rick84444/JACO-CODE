{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://mimirpower.se/#faq",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is JACO (Just Autonomous Agent Orchestrator)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JACO is a user-controlled autonomous agent operating system for managing multiple language models (Gemini, Ollama, OpenAI), persistent memory, verified source code generation and mobile integration via Termux on Android."
      }
    },
    {
      "@type": "Question",
      "name": "How does JACO differ from OpenClaw, LangGraph and ordinary chat apps?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JACO combines a local runtime, a Termux hardware bridge, the PODAR self-improvement loop, approval gates via push notifications and an Agent-to-Agent (A2A) marketplace protocol in one complete and transparent system."
      }
    },
    {
      "@type": "Question",
      "name": "Can JACO run locally on Android via Termux?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, JACO can be installed in Termux with Node.js and run locally together with Ollama for fully offline agent execution."
      }
    },
    {
      "@type": "Question",
      "name": "How are security and approvals handled in JACO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Harmful or critical actions (command execution and file writes) require explicit approval via mobile push notifications or a local interface."
      }
    }
  ]
}
