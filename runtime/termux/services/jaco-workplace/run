#!/data/data/com.termux/files/usr/bin/sh
set -eu

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
TMPDIR="${TMPDIR:-$PREFIX/tmp}"
PATH="$PREFIX/bin:$PREFIX/bin/applets:${PATH:-/system/bin}"
mkdir -p "$TMPDIR"
export PREFIX HOME TMPDIR PATH


ENV_FILE="${JACO_RUNTIME_ENV:-$HOME/.config/jaco/runtime.env}"
[ -f "$ENV_FILE" ] && . "$ENV_FILE"

# Runit must never silently execute the obsolete ~/jaco-code checkout.
# jacoctl writes the canonical JACO_ROOT into the mode-600 runtime.env.
[ -f "$ENV_FILE" ] && [ -n "${JACO_ROOT:-}" ] && [ -f "$JACO_ROOT/run_termux_node.sh" ] || {
  echo "JACO_ROOT_INVALID: configure the installed checkout in $ENV_FILE" >&2
  exit 41
}

REPO_ROOT="$(cd "$JACO_ROOT/.." && pwd)"
cd "$REPO_ROOT"

export JACO_WORKSPACE_ROOT="${JACO_WORKSPACE_ROOT:-$REPO_ROOT}"
export JACO_WORKPLACE_HOST="${JACO_WORKPLACE_HOST:-127.0.0.1}"
export JACO_WORKPLACE_PORT="${JACO_WORKPLACE_PORT:-2995}"
export JACO_WORKPLACE_URL="${JACO_WORKPLACE_URL:-http://127.0.0.1:2995}"
export JACO_WORKPLACE_REQUIRED="1"
export JACO_WORKPLACE_SUPERVISE_MODEL="1"
export JACO_WORKPLACE_SUPERVISE_SEER="1"
export JACO_WORKPLACE_SUPERVISE_NOVA="1"
export JACO_LEVEL5_AUTONOMY="${JACO_LEVEL5_AUTONOMY:-1}"
export JACO_ALLOW_SHELL_TASKS="${JACO_ALLOW_SHELL_TASKS:-1}"
export JACO_REMOTE_ALLOW_MUTATIONS="${JACO_REMOTE_ALLOW_MUTATIONS:-1}"
export JACO_RUNTIME_URL="${JACO_RUNTIME_URL:-http://127.0.0.1:3000}"
export SEER_URL="${SEER_URL:-http://127.0.0.1:2997}"

# Optional, explicit GitHub CLI transport for the PRIVATE Workplace relay.
# Only this service receives the token; it is never stored in runtime.env.
if [ "${JACO_CHATGPT_WORKPLACE_GH_CLI:-0}" = "1" ] && [ -z "${JACO_CHATGPT_WORKPLACE_TOKEN:-}" ]; then
  [ -n "${JACO_CHATGPT_WORKPLACE_REPO:-}" ] && [ -n "${JACO_CHATGPT_WORKPLACE_ACTOR:-}" ] || {
    echo "JACO_CHATGPT_RELAY_PRIVATE_REPO_AND_ACTOR_REQUIRED" >&2
    exit 45
  }
  command -v gh >/dev/null 2>&1 || { echo "JACO_CHATGPT_RELAY_GH_CLI_MISSING" >&2; exit 45; }
  JACO_CHATGPT_WORKPLACE_TOKEN="$(gh auth token 2>/dev/null)" || {
    echo "JACO_CHATGPT_RELAY_GH_AUTH_REQUIRED" >&2
    exit 45
  }
  [ -n "$JACO_CHATGPT_WORKPLACE_TOKEN" ] || { echo "JACO_CHATGPT_RELAY_GH_TOKEN_EMPTY" >&2; exit 45; }
  export JACO_CHATGPT_WORKPLACE_TOKEN
fi

exec "$PREFIX/bin/node" --experimental-sqlite gateway/src/workplace/workplace-server.mjs 2>&1
