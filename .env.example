# JACO runtime configuration
# Copy to .env. Never commit .env or real credentials.

# Required: generate a random value with at least 24 characters.
JACO_GATEWAY_TOKEN=
GATEWAY_TOKEN=

# Canonical local services
JACO_RUNTIME_URL=http://127.0.0.1:3000
SEER_URL=http://127.0.0.1:2997
NOVA_BRIDGE_URL=http://127.0.0.1:4243
# direct = local Nova Bridge REST (/observe, /click, ...)
# gateway = authenticated public gateway (/v1/nova/*), e.g. Cloudflare -> Windows CDP
JACO_NOVA_TRANSPORT=direct
NOVA_BRIDGE_PORT=4243
CDP_PORT=9222

# Runtime directory relative to repository root unless an absolute path is used.
JACO_RUNTIME_DIR=runtime

# Executor selection
# hands-off         = current production fallback
# desktop-agentos   = SEER -> durable mission -> ModelRelay -> Windows UIA
JACO_EXECUTOR=hands-off

# Broad local mission capability allowlist. Workspace writes, tests, local Git
# commits, browser actions and semantic desktop actions are available by default.
# Raw shell is globally available but must still be explicitly requested by a mission.
# External publication/deployment/payment capabilities are intentionally absent.
JACO_NOVA_ALLOWED_TASKS=detect-surfaces,health-check,check-revenue,browser-survey-site,browser-click,browser-type,desktop-windows,desktop-observe,desktop-action,desktop-invoke,windows-wmi-read,screenshot,get-cursor,invoke-worker,shell,repo-list,repo-read,repo-write,repo-test,git-status,git-diff,git-commit,git-push,git-merge

# Desktop AgentOS policy. Semantic mutation remains bounded by ModelRelay/receipts;
# external/high-consequence actions keep their dedicated gates.
JACO_AUTONOMY_MANDATE_ID=
JACO_ALLOW_COORDINATE_FALLBACK=0
JACO_ALLOW_SHELL_TASKS=1
JACO_AGENTOS_POLL_MS=1500

# Browser scope
JACO_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# External ingress is disabled unless explicitly enabled.
JACO_START_TUNNEL=0

# Local SEER model selection is intentionally not hardcoded.
# auto: prefer LiteRT-LM, then llama.cpp, then Ollama when healthy.
# llamacpp / litert / ollama: force that local provider family and fail closed if unavailable.
# Termux can auto-start an installed llama.cpp/Bonsai when LiteRT is unavailable.
# An explicit provider choice is preserved even when llama.cpp files exist.
# To save a local selection for Aura and SEER across restarts:
#   jaco restart --provider litert --model <ID from litert-lm list>
# Explicit litert/llamacpp selection disables cloud planning and remote inference.
# off: disable local provider discovery (paid providers still require explicit opt-in).
JACO_SEER_PROVIDER_PREFERENCE=auto
JACO_SEER_MODEL_DISCOVERY_TIMEOUT_MS=2500
# Local inference may be slower on Android/Termux. The Nova client timeout must
# remain longer than the SEER provider timeout so the server can return cleanly.
JACO_SEER_INFERENCE_TIMEOUT_MS=180000
JACO_SEER_CLIENT_TIMEOUT_MS=200000

# Workplace dependency supervision (Termux activation enables these automatically).
# Nova starts only after Core, a local model provider, and a real SEER brain inference are READY.
JACO_WORKPLACE_SUPERVISE_MODEL=1
JACO_WORKPLACE_SUPERVISE_SEER=1
JACO_WORKPLACE_SUPERVISE_NOVA=1
JACO_LEVEL5_AUTONOMY=1
JACO_REMOTE_ALLOW_MUTATIONS=1
JACO_WORKPLACE_DEPENDENCY_WAIT_MS=300000
JACO_WORKPLACE_SEER_BRAIN_MAX_TOKENS=128
JACO_WORKPLACE_SEER_BRAIN_TIMEOUT_MS=180000

# Android / Termux llama.cpp. In auto mode jaco activate starts it only when both
# the server binary and the model file exist; otherwise the normal provider chain continues.
JACO_LLAMACPP_AUTOSTART=auto
JACO_LLAMACPP_AUTODETECT=1
JACO_LLAMACPP_URL=http://127.0.0.1:9380/v1
JACO_LLAMACPP_SERVER=
JACO_LLAMACPP_MODEL=
JACO_LLAMACPP_CTX=8192

# Android / Termux LiteRT-LM. The default endpoint is loopback-only.
# An empty model lets SEER discover /v1/models; use a registry ID, not a download filename.
# JACO_LITERT_COMMAND can point to the executable if the service PATH differs.
JACO_LITERT_URL=http://127.0.0.1:9379/v1
JACO_LITERT_MODEL=

# Desktop/local Ollama fallback. OLLAMA_MODEL and JACO_OLLAMA_MODEL are both accepted.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
JACO_OLLAMA_MODEL=
# Explicit Ollama Cloud models offered only in manual Aura chat. The economic
# policy must separately enable manualAuraCloudEnabled; unknown models are denied.
JACO_AURA_OLLAMA_CLOUD_MODELS=
JACO_AURA_DEFAULT_MODEL=
# Model names are configuration, not runtime constants. Unknown Cloud models need
# verified USD prices per million input/output tokens before they can be used.
# Example: {"new-model:cloud":{"input":1.25,"output":5.00}}
JACO_OLLAMA_CLOUD_PRICES_JSON=
# The primary Nova provider is authoritative over a previously saved GUI choice.
# Set to ollama-cloud, groq, openrouter, ollama-local, etc. Provider availability
# never bypasses paid-model and daily cost gates.
JACO_PRIMARY_PROVIDER=
# SEER keeps local inference unless explicitly configured. Metered fallback
# providers are off by default; list only providers with an approved cost gate.
JACO_SEER_CLOUD_FALLBACKS=
# Nova uses Ollama's direct Cloud API; use the model identifier Ollama exposes.
OLLAMA_CLOUD_MODEL=gpt-oss:120b
JACO_OLLAMA_CLOUD_MODELS=

# Optional commerce. Leave empty when unused.
STRIPE_SECRET_KEY=

# Optional external model providers. Local operation does not require them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# Free tier (no card required): console.groq.com -> API Keys. Used for aura.reason
# strategy generation via openai/gpt-oss-120b instead of paid Ollama Cloud.
GROQ_API_KEY=

# Optional deployment/integration credentials.
HF_TOKEN=
CLOUDFLARE_API_TOKEN=

# Operator workflow for Desktop AgentOS:
# 1. Configure this file or run agents/setup-desktop-agentos.ps1.
# 2. Start the stack with agents/start-all.ps1.
# 3. Create and sign a time-limited desktop mandate with agents/grant-desktop-agentos.ps1.
# 4. Submit a durable Nova/SEER mission through /api/connected/nova/missions.

# ── Autonomy hardening (claude/harden-autonomy) ──────────────────────────────
# Outgoing spend: every acting Nova/Desktop task passes spendGuard.mjs. A paying action BLOCKS the
# mission; the operator approves one action by resuming it with a note containing [approve-spend].
# Agents commit in their own worktree and never push/merge a protected branch; master changes via PR + green CI.
JACO_NOVA_CODING_ROOT=
JACO_PROTECTED_BRANCHES=master,main
# Auto-resolution of BLOCKED / AWAITING_VERIFICATION missions (agents/lib/approval-policy.mjs), 0-5.
# Default is full autonomy (5); lower it to restrict. Outgoing spend always waits for the operator.
JACO_AUTO_APPROVE_LEVEL=5
# 1 lets agents change the auto-approval rules (logged, with reason); spend stays blocked regardless.
JACO_POLICY_EDIT_GRANT=0
# Parent for SEER sub-goals created from Aura (seer_subgoal tool).
JACO_ROOT_GOAL_ID=
# Durable SEER memory folder (one JSON file per key). Empty = .jaco/memory/seer.
JACO_MEMORY_DIR=
# Characters of SEER active memory attached to every model call.
SEER_MEMORY_BLOCK_CHARS=12000
# Free model providers Nova may fail over to without JACO_ALLOW_PAID_MODELS.
GROQ_API_KEY=
OPENROUTER_API_KEY=
JACO_OLLAMA_LOCAL_MODEL=gemma3:4b
# 1 = Desktop AgentOS takes every mission (sole executor); default = only desktop-agentos missions.
JACO_DESKTOP_TAKES_ALL=0

# Web fetch: 240 minutes (milliseconds).
JACO_WEB_FETCH_TIMEOUT_MS=14400000
